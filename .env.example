APP_NAME=resume-agent-backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://resume:resume@postgres:5432/resume_agent
REDIS_URL=redis://redis:6379/0
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
ARTIFACT_ROOT=/app/data/artifacts
LATEX_COMPILE_COMMAND=xelatex
LATEX_TIMEOUT_SECONDS=60
CELERY_TASK_ALWAYS_EAGER=false
JOB_DISPATCH_MODE=auto
